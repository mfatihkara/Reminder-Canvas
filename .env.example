# Preferred: Canvas Calendar Feed URL (works without API token)
CANVAS_ICAL_URL=replace_me

# Optional fallback: Canvas API (only if your school allows access tokens)
CANVAS_BASE_URL=https://jhu.instructure.com
CANVAS_API_TOKEN=replace_me

# Notification target and delivery mode
# NOTIFIER_MODE: email_gateway (free) or twilio
NOTIFIER_MODE=email_gateway
NOTIFY_TARGET=replace_me

# Email gateway mode (recommended free setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_me@gmail.com
SMTP_PASSWORD=replace_me
SMTP_FROM_EMAIL=replace_me@gmail.com

# Twilio mode (optional paid fallback)
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+15555555555

TIMEZONE=America/New_York
REMIND_DAYS_AHEAD=3
STATE_DB_PATH=state.db
